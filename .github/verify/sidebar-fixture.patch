         try super.tearDownWithError()
     }
 
+    func testSidebarFoldingEvidence() throws {
+        try XCTSkipIf(UIDevice.current.userInterfaceIdiom != .phone, "Phone sidebar only")
+        self.launchApp(for: Self.chatScreenshotTarget, additionalArguments: ["--openclaw-sidebar-folding-fixture"])
+        let app = try XCTUnwrap(self.app)
+        self.tapSidebarReveal(in: app)
+        let release = app.buttons.matching(NSPredicate(format: "label CONTAINS %@", "Release plan")).firstMatch
+        XCTAssertTrue(release.waitForExistence(timeout: 10))
+        Thread.sleep(forTimeInterval: 1.5)
+        // Screenshots come first so the main-branch run still records its before state.
+        self.attachScreenshot(named: "sidebar-folding-drawer")
+        let hasFindings = app.buttons.matching(NSPredicate(format: "label CONTAINS %@", "Findings summary"))
+            .firstMatch.exists
+        let runRows = ["Competitor research", "Hotel booking", "Inbox triage"].filter {
+            app.buttons.matching(NSPredicate(format: "label BEGINSWITH %@", $0)).firstMatch.exists
+        }
+        release.press(forDuration: 0.8)
+        let offersMarkAsRead = app.buttons["Mark as Read"].waitForExistence(timeout: 4)
+        self.attachScreenshot(named: "sidebar-folding-menu")
+        XCTAssertTrue(hasFindings, "The run's child chat should take the run's place")
+        XCTAssertEqual(runRows, [], "Subagent runs listed as rows")
+        XCTAssertTrue(offersMarkAsRead, "The parent menu should offer Mark as Read for its unread run")
+    }
+
+    func testSidebarReadEvidence() throws {
+        try XCTSkipIf(UIDevice.current.userInterfaceIdiom != .phone, "Phone sidebar only")
+        self.launchApp(for: Self.chatScreenshotTarget, additionalArguments: [
+            "--openclaw-sidebar-folding-fixture",
+            "--openclaw-sidebar-read-fixture",
+        ])
+        let app = try XCTUnwrap(self.app)
+        self.tapSidebarReveal(in: app)
+        func row(_ title: String) -> XCUIElement {
+            app.buttons.matching(NSPredicate(format: "label CONTAINS %@", title)).firstMatch
+        }
+        let launch = row("Launch prep")
+        XCTAssertTrue(launch.waitForExistence(timeout: 10))
+        XCTAssertTrue(row("Launch copy").waitForExistence(timeout: 5))
+        XCTAssertFalse(row("Copy review").exists, "The completed run should fold into Launch copy")
+        // Collapse Launch prep with the chevron on its own row.
+        let chevrons = app.buttons.matching(NSPredicate(format: "label == %@", "Hide Sub-sessions"))
+            .allElementsBoundByIndex
+        let chevron = try XCTUnwrap(chevrons.min { abs($0.frame.midY - launch.frame.midY) <
+                abs($1.frame.midY - launch.frame.midY) })
+        chevron.tap()
+        XCTAssertTrue(row("Launch copy").waitForNonExistence(timeout: 5))
+        Thread.sleep(forTimeInterval: 1)
+        self.attachScreenshot(named: "sidebar-collapsed-unread")
+        XCTAssertTrue((launch.value as? String ?? "").contains("Unread"), "Collapsed Launch prep should stay unread")
+
+        let home = app.buttons["RootTabs.Sidebar.Destination.chat"]
+        XCTAssertTrue(home.waitForExistence(timeout: 5))
+        XCTAssertEqual(home.value as? String, "Unread")
+        home.press(forDuration: 0.8)
+        let markRead = app.buttons["Mark as Read"]
+        XCTAssertTrue(markRead.waitForExistence(timeout: 4), "Home should offer Mark as Read for its folded runs")
+        self.attachScreenshot(named: "sidebar-home-menu")
+        markRead.tap()
+        let cleared = NSPredicate { element, _ in ((element as? XCUIElement)?.value as? String ?? "").isEmpty }
+        let wait = XCTWaiter.wait(for: [XCTNSPredicateExpectation(predicate: cleared, object: home)], timeout: 8)
+        Thread.sleep(forTimeInterval: 1)
+        self.attachScreenshot(named: "sidebar-home-read")
+        XCTAssertEqual(wait, .completed, "Mark as Read should clear Home's unread runs")
+        XCTAssertFalse(home.label.contains("failed"), "The unread failure line should clear with the run")
+    }
